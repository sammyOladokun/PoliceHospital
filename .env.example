# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Police Hospital Platform"
APP_ENV="development"                       # development | staging | production

# ---------------------------------------------------------------------------
# Platform database (accounts, roles, audit log, portal-side records).
# NOT the clinical record of truth — that lives in the hospital HIS below.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://police_hospital:police_hospital_dev@localhost:5432/police_hospital?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Online booking ("Book Now" dialog)
# ---------------------------------------------------------------------------
# A Calendly event link or a Google Calendar appointment-schedule link; it is
# embedded in the booking dialog. Leave empty to show the phone numbers instead.
#   Calendly: https://calendly.com/<account>/<event>
#   Google:   https://calendar.google.com/calendar/appointments/schedules/<id>
#             (from the schedule's "Website embed" option, not the short link)
# Inlined at build time — rebuild after changing it.
NEXT_PUBLIC_BOOKING_URL=""

# ---------------------------------------------------------------------------
# Hospital Information System — the hospital's local server
# ---------------------------------------------------------------------------
# HIS_MODE:
#   local → serve reference data and demo records from the repo. The public
#           site, search, and dashboards work with no hospital server present.
#   fhir  → read live data from an HL7 FHIR R4 endpoint. That endpoint is either
#           a native FHIR server on the hospital LAN, or a FHIR facade placed in
#           front of the existing HIS (see ARCHITECTURE.md).
HIS_MODE="local"

# Private-network address only. Must never be reachable from a patient browser.
# Example: https://his.pch.local/fhir
HIS_BASE_URL=""

# Bearer token issued by the HIS / facade for this application.
HIS_API_KEY=""

# Transport tuning for a hospital LAN.
HIS_TIMEOUT_MS="8000"
HIS_RETRIES="2"

# Set to "true" ONLY for a LAN server using a self-signed certificate, and only
# with a pinned CA on the host. Never enable this for an internet-facing host.
HIS_ALLOW_SELF_SIGNED="false"
